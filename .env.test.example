# Copia este archivo a .env.test (gitignorado) y llena con credenciales
# reales de una cuenta de prueba — nunca la del admin real ni una con
# datos sensibles si se puede evitar. Las pruebas de tests/ solo navegan y
# verifican, no crean/editan/borran nada, pero de todas formas es mejor
# usar una cuenta dedicada si existe.
ROBSEN_TEST_EMAIL=
ROBSEN_TEST_PASSWORD=

# Opcional: apuntar a otro entorno en vez del sitio de producción.
# ROBSEN_BASE_URL=https://robseninterno.com
