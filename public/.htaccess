Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Sin "/" al inicio del destino a propósito: con la barra absoluta, esta
# regla dentro de /preview/.htaccess reescribía hacia /index.html en la
# RAÍZ del dominio (producción) en vez de /preview/index.html — cualquier
# entrada directa a una ruta profunda bajo /preview/ (ej. /preview/booking,
# o un F5 en /preview/ventas) terminaba sirviendo el bundle de producción.
# Sin la barra, mod_rewrite resuelve el destino relativo al directorio del
# .htaccess que lo procesa, así que un mismo archivo funciona igual en la
# raíz (producción) y en /preview/.
RewriteRule ^ index.html [L]

# Control de caché. El index.html es el que decide qué bundles cargar: si el
# navegador lo cachea, se queda con una versión vieja y no ve los cambios
# desplegados (justo el síntoma de "no me aparece el cambio"). Por eso el HTML
# siempre revalida. Los assets llevan hash en el nombre (index-ABC123.js), así
# que son inmutables y se pueden cachear por mucho tiempo sin riesgo.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
